# Hosted Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Modern Supabase Publishable Key (starts with sb_publishable_) or legacy Anon key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key

# Optional: Default Currency (Defaults to INR if omitted)
VITE_DEFAULT_CURRENCY=INR

# Optional: Password required to edit account totals in Settings
VITE_SETTINGS_PASSWORD=fintrack123
